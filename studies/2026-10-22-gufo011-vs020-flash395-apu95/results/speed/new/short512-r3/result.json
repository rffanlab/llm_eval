          "role": "assistant",
          "content": "```python\n\"\"\"\nA library of small pure functions for invoice validation, event sorting, and amount summarization.\n\"\"\"\n\nfrom typing import List, Dict, Any, Union, Optional\nfrom datetime import datetime\n\n\ndef is_valid_invoice_structure(invoice: Dict[str, Any]) -> bool:\n    \"\"\"\n    Check if the invoice dictionary has the required top-level keys.\n    \n    Args:\n        invoice: A dictionary representing an invoice.\n        \n    Returns:\n        True if the invoice has 'id', 'date', 'items', and 'total' keys, False otherwise.\n    \"\"\"\n    required_keys = {'id', 'date', 'items', 'total'}\n    return all(key in invoice for key in required_keys)\n\n\ndef is_valid_invoice_id(invoice_id: Any) -> bool:\n    \"\"\"\n    Check if the invoice ID is a non-empty string.\n    \n    Args:\n        invoice_id: The ID of the invoice.\n        \n    Returns:\n        True if the ID is a non-empty string, False otherwise.\n    \"\"\"\n    return isinstance(invoice_id, str) and len(invoice_id.strip()) > 0\n\n\ndef is_valid_invoice_date(date_str: Any) -> bool:\n    \"\"\"\n    Check if the date string is in ISO format (YYYY-MM-DD).\n    \n    Args:\n        date_str: The date string to validate.\n        \n    Returns:\n        True if the date is valid ISO format, False otherwise.\n    \"\"\"\n    if not isinstance(date_str, str):\n        return False\n    try:\n        datetime.strptime(date_str, '%Y-%m-%d')\n        return True\n    except ValueError:\n        return False\n\n\ndef is_valid_item_structure(item: Dict[str, Any]) -> bool:\n    \"\"\"\n    Check if an item dictionary has the required keys.\n    \n    Args:\n        item: A dictionary representing an invoice item.\n        \n    Returns:\n        True if the item has 'name', 'quantity', and 'price' keys, False otherwise.\n    \"\"\"\n    required_keys = {'name', 'quantity', 'price'}\n    return all(key in item for key in required_keys)\n\n\ndef is_valid_item_name(name: Any) -> bool:\n    \"\"\"\n    Check if the item name is a non-empty string.\n    \n    Args:\n        name: The name of the item.\n        \n   "
        },
